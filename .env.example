MAIN_DB_URL=
MAIN_DB_USER=
MAIN_DB_PASSWORD=
MAIN_DB=
MAIN_DB_PORT=

PORT=
JWT_SECRET=
# Origem(ns) do front liberada(s) no CORS. Lista separada por vírgula.
FRONT_URL=

# --- Sessão -------------------------------------------------------------------
# Validade do access token. Curto de propósito: é ele que carrega os papéis, e
# a renovação automática pelo refresh token torna esse prazo invisível ao usuário.
JWT_EXPIRES_IN=15m

# Validade da sessão longa (refresh token). Passado esse prazo sem uso, o
# usuário refaz o login.
REFRESH_TOKEN_DAYS=7

# Janela em que reapresentar um refresh já rotacionado é tratado como corrida
# entre abas, e não como token roubado. Ver AuthService.withinReuseGrace.
REFRESH_REUSE_GRACE_SECONDS=30

# Path do cookie de refresh, comparado com a URL vista pelo NAVEGADOR. Deixe em
# '/' se a API é publicada na raiz do host. Se um proxy a publica sob prefixo,
# restrinja para o prefixo + /auth (ex.: /api/auth) — nunca só '/auth', ou o
# cookie deixa de ser enviado e a sessão morre em silêncio.
REFRESH_COOKIE_PATH=/

# Path do cookie do ACCESS token. Ele acompanha toda requisição à API (não só
# /auth), então mantenha '/' — ou o prefixo sob o qual o proxy publica a API
# inteira (ex.: /api). Restringir a '/auth' aqui derrubaria a autenticação.
ACCESS_COOKIE_PATH=/

# Vale para os DOIS cookies de sessão.
# 'lax' enquanto front e API dividem o mesmo site (mesmo host ou subdomínios do
# mesmo domínio). Só domínios de registro diferentes exigem 'none' — que por sua
# vez exige HTTPS dos dois lados.
AUTH_COOKIE_SAMESITE=lax
